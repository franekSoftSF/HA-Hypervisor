#!/bin/sh
set -e

NAME=ha-hypervisor-agent

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl disable --now "$NAME.service" >/dev/null 2>&1 || true
    # Further agents, ha-hypervisor-agent@NAME, enabled by hand.
    for unit in /etc/systemd/system/*.wants/"$NAME"@*.service; do
        [ -e "$unit" ] || continue
        systemctl disable "$(basename "$unit")" >/dev/null 2>&1 || true
    done
    systemctl stop "$NAME@*.service" >/dev/null 2>&1 || true
fi

exit 0
